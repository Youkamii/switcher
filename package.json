{
  "name": "switcher-widget",
  "version": "1.2.0",
  "description": "Desktop widget that switches between multiple Claude Code / Codex CLI accounts in one click, with per-account usage bars (Windows/macOS)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Youkamii/switcher.git"
  },
  "homepage": "https://github.com/Youkamii/switcher#readme",
  "keywords": [
    "claude-code",
    "codex",
    "account-switcher",
    "widget",
    "tauri",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "scripts/launch.mjs",
    "scripts/dist.mjs"
  ],
  "type": "module",
  "bin": {
    "switcher": "scripts/launch.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
